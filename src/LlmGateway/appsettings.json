{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Usage": "Data Source=data/usage.db"
  },
  "Gateway": {
    "Resilience": {
      "AttemptTimeout": "00:01:00",
      "MaxRetryAttempts": 2,
      "RetryBaseDelay": "00:00:00.250",
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerSamplingDuration": "00:00:30",
      "CircuitBreakerBreakDuration": "00:00:30"
    },
    "Cache": {
      "Enabled": true,
      "Ttl": "01:00:00",
      "MaxEntries": 10000
    },
    "Guardrails": {
      "MaxRequestBytes": 1048576,
      "RedactPii": true,
      "BlockedTerms": []
    },
    "Upstreams": {
      "offline": {
        "Kind": "Fake"
      }
    },
    "Models": {
      "chat-default": {
        "Kind": "Chat",
        "Targets": [
          { "Upstream": "offline", "Model": "offline-chat" }
        ]
      },
      "embed-default": {
        "Kind": "Embedding",
        "Targets": [
          { "Upstream": "offline", "Model": "offline-embed" }
        ]
      }
    }
  }
}
