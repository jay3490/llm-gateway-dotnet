{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Upstreams": {
      "offline": {
        "Kind": "Fake"
      }
    },
    "Models": {
      "chat-default": {
        "Kind": "Chat",
        "Targets": [
          { "Upstream": "offline", "Model": "offline-chat" }
        ]
      },
      "embed-default": {
        "Kind": "Embedding",
        "Targets": [
          { "Upstream": "offline", "Model": "offline-embed" }
        ]
      }
    }
  }
}
