{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Usage": "Data Source=data/usage.db"
  },
  "Gateway": {
    "Resilience": {
      "AttemptTimeout": "00:01:00",
      "MaxRetryAttempts": 2,
      "RetryBaseDelay": "00:00:00.250",
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerSamplingDuration": "00:00:30",
      "CircuitBreakerBreakDuration": "00:00:30"
    },
    "Cache": {
      "Enabled": true,
      "Store": "Memory",
      "RedisKeyPrefix": "llmgw:",
      "MaxSemanticCandidates": 500,
      "Ttl": "01:00:00",
      "MaxEntries": 10000,
      "SemanticEnabled": true,
      "EmbeddingModel": "embed-default",
      "SimilarityThreshold": 0.95
    },
    "Guardrails": {
      "MaxRequestBytes": 1048576,
      "RedactPii": true,
      "BlockedTerms": []
    },
    "Upstreams": {
      "offline": {
        "Kind": "Fake"
      }
    },
    "Models": {
      "chat-default": {
        "Kind": "Chat",
        "Targets": [
          { "Upstream": "offline", "Model": "offline-chat" }
        ]
      },
      "embed-default": {
        "Kind": "Embedding",
        "Targets": [
          { "Upstream": "offline", "Model": "offline-embed" }
        ]
      }
    }
  }
}
